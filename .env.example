# Copy to .env (never commit .env). Placeholders only.
OPENAI_API_KEY=your-openai-api-key-here
# Optional: load the key from a file outside the project instead of the environment
# NEXUS_OPENAI_KEY_FILE=C:\path\outside\project\env
NEXUS_OPENAI_MODEL=gpt-6-luna
# low | medium | high | none (omit the reasoning parameter)
NEXUS_OPENAI_REASONING=low
# Set to 1 to force engine-only mode
NEXUS_DISABLE_LLM=0
